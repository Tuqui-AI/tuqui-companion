<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tuqui_assistant.Panel">
        <!-- The card stays MOUNTED while panelOpen (iframe included): minimizing
             it only adds `o-tuqui-away`, it never unmounts — a remount would
             spend a second single-use SSO nonce → 401, and the conversation
             would be gone. That class fades it out towards its own corner
             (panel.scss), and the launcher below takes its place. Closing (the X)
             is what unmounts it. -->
        <div t-if="this.state.panelOpen" class="o-tuqui-panel d-flex flex-column"
             t-ref="this.panelRef"
             t-att-class="{ 'o-tuqui-away': this.state.minimized, 'o-tuqui-expanded': this.state.expanded }">
            <!-- Header -->
            <div class="o-tuqui-panel-header d-flex align-items-center justify-content-between">
                <span class="o-tuqui-brand d-flex align-items-center">
                    <!-- The logo is the conversations menu: under the pointer it
                         turns into the menu icon, so the brand stays and no icon
                         is added. The name keeps opening Tuqui in a new tab. -->
                    <button class="btn btn-sm o-tuqui-menu-toggle" t-on-click="this.toggleSpaMenu"
                            t-att-class="{ 'o-tuqui-menu-hint': this.ui.menuHint }"
                            t-att-title="this.menuLabel" t-att-aria-label="this.menuLabel">
                        <img class="o-tuqui-logo"
                             src="/tuqui_assistant/static/img/tuqui-smile.svg" alt=""/>
                        <svg class="o-tuqui-menu-icon" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                             stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                            <path d="M9 3v18"/>
                        </svg>
                    </button>
                    <button class="btn btn-sm o-tuqui-title" t-on-click="this.openInTuqui"
                            t-att-title="this.openInTuquiLabel" t-att-aria-label="this.openInTuquiLabel">Tuqui</button>
                </span>
                <span class="o-tuqui-header-actions d-flex align-items-center">
                    <button class="btn btn-sm o-tuqui-minimize" t-on-click="this.minimize"
                            t-att-title="this.minimizeLabel" t-att-aria-label="this.minimizeLabel">
                        <i class="oi" data-icon="remove"/>
                    </button>
                    <button class="btn btn-sm o-tuqui-expand"
                            t-on-click="this.state.expanded ? this.contract : this.expand"
                            t-att-title="this.state.expanded ? this.contractLabel : this.expandLabel"
                            t-att-aria-label="this.state.expanded ? this.contractLabel : this.expandLabel">
                        <i class="oi" t-att-data-icon="this.state.expanded ? 'close_fullscreen' : 'expand_content'"/>
                    </button>
                    <button class="btn btn-sm o-tuqui-close" t-on-click="this.close"
                            t-att-title="this.closeLabel" t-att-aria-label="this.closeLabel">
                        <i class="oi" data-icon="close_small"/>
                    </button>
                </span>
            </div>

            <!-- L1: iframe del SPA de Tuqui (modo embed). Solo si el companion
                 está conectado (slug + estado active). -->
            <t t-if="this.ui.connected and this.ui.slug">
                <!-- The wrapper exists for the overlay below: it gives it a
                     containing block that covers the iframe and NOT the header, so
                     the close button stays reachable while it shows. -->
                <div class="o-tuqui-embed-wrap position-relative flex-grow-1 d-flex">
                    <iframe class="o-tuqui-iframe flex-grow-1"
                            t-ref="this.iframeRef"
                            t-att-src="this.embedUrl"
                            allow="microphone; clipboard-write; clipboard-read"
                            title="Tuqui"/>
                    <!-- The iframe stays mounted underneath: if the handshake was
                         merely slow, unmounting would lose the session it just
                         finished establishing, and the nonce is single-use. So this
                         overlays rather than replaces: a late "ready" clears it and
                         the working chat is already behind it. -->
                    <!-- Until the chat greets: something that says it is on its way,
                         instead of a blank frame for up to the whole timeout. -->
                    <div t-if="!this.ui.embedReady and !this.ui.embedBlocked"
                         class="o-tuqui-loading d-flex flex-column align-items-center justify-content-center text-center p-4"
                         role="status">
                        <img class="o-tuqui-logo mb-3" style="width: 48px;"
                             src="/tuqui_assistant/static/img/tuqui-smile.svg" alt="Tuqui"/>
                        <span class="o-tuqui-loading-dots mb-2" aria-hidden="true"><i/><i/><i/></span>
                        <p class="o-tuqui-msg-body mb-0">Opening Tuqui…</p>
                    </div>
                    <div t-if="this.ui.embedBlocked"
                         class="o-tuqui-blocked d-flex flex-column align-items-center justify-content-center text-center p-4">
                        <img class="o-tuqui-logo mb-3" style="width: 48px;"
                             src="/tuqui_assistant/static/img/tuqui-smile.svg" alt="Tuqui"/>
                        <t t-if="!this.ui.originAuthorized">
                            <p class="o-tuqui-msg-title mb-1">This URL is not enabled for Tuqui</p>
                            <p class="o-tuqui-msg-body mb-0">
                                <t t-if="this.ui.mainOrigin">Open Odoo from <b t-out="this.ui.mainOrigin"/>, or ask an admin to add <b t-out="this.currentOrigin"/> in Settings → Tuqui.</t>
                                <t t-else="">Ask an admin to add <b t-out="this.currentOrigin"/> in Settings → Tuqui.</t>
                                <a t-att-href="this.assistantUrlsDocs" target="_blank" rel="noopener">How to do it</a>
                            </p>
                        </t>
                        <t t-elif="this.ui.embedFailed">
                            <p class="o-tuqui-msg-title mb-1">Tuqui could not open</p>
                            <p class="o-tuqui-msg-body mb-0">
                                Try reloading the page. If it keeps happening, tell whoever manages your Tuqui.
                            </p>
                        </t>
                        <t t-else="">
                            <p class="o-tuqui-msg-title mb-1">Tuqui did not finish opening</p>
                            <p class="o-tuqui-msg-body mb-2">
                                You are on <b t-out="this.currentOrigin"/>. The browser may be blocking the panel because that domain is not enabled yet, or Tuqui took longer than expected.
                            </p>
                            <!-- Only a reload retries: the close and systray buttons just minimize, so panelOpen stays true. -->
                            <p class="o-tuqui-msg-body mb-0">
                                Try reloading the page. If it keeps happening, tell whoever manages your Tuqui, with the domain above.
                            </p>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Sin companion conectado: prompt para conectar Tuqui. El chat
                 vive atado a companion, así que no hay fallback. -->
            <t t-else="">
                <div class="o-tuqui-disconnected flex-grow-1 d-flex flex-column align-items-center justify-content-center text-center p-4">
                    <img class="o-tuqui-logo mb-3" style="width: 48px; opacity: .8;"
                         src="/tuqui_assistant/static/img/tuqui-smile.svg" alt="Tuqui"/>
                    <t t-if="this.ui.copyPending">
                        <p class="mb-1 fw-bold">This database is a copy of one connected to Tuqui</p>
                        <p class="small text-muted mb-0" t-if="this.ui.copyStatus === 'failed'">
                            Could not connect it as a test database. Try again later, or from Settings.
                        </p>
                        <p class="small text-muted mb-0" t-elif="this.ui.copyStatus === 'registering'">
                            Connecting it as a test database…
                        </p>
                        <p class="small text-muted mb-0" t-else="">
                            Connecting it as a test database. Open the assistant again in a moment.
                        </p>
                    </t>
                    <t t-else="">
                        <p class="mb-1 fw-bold">Tuqui is not connected to this Odoo</p>
                        <p class="small text-muted mb-0">
                            Connect Tuqui (companion) from Settings to use the assistant here.
                        </p>
                    </t>
                </div>
            </t>
        </div>

        <!-- Minimized, the card becomes a bubble in the same corner and size as
             Odoo's chat bubbles, stacked above them (panel.js measures their
             column). Clicking it brings the same conversation back. -->
        <button t-if="this.state.panelOpen and this.state.minimized" class="o-tuqui-launcher"
                t-on-click="this.restore" t-att-title="this.restoreLabel" t-att-aria-label="this.restoreLabel">
            <img src="/tuqui_assistant/static/img/tuqui-smile.svg" alt=""/>
        </button>
    </t>
</templates>
