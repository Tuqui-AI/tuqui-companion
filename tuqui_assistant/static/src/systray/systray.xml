<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tuqui_assistant.Systray">
        <!-- The icon is a switch and, with the bubble gone, the only way in and
             out: it has to say which one the next click is. `aria-pressed` for
             screen readers, `o-active` for the eye. -->
        <button class="o_nav_entry o-tuqui-systray-btn" t-on-click="this.onClick"
                t-att-class="{ 'o-active': this.showing }"
                t-att-aria-pressed="this.showing ? 'true' : 'false'"
                t-att-title="this.showing ? this.hideLabel : this.showLabel"
                t-att-aria-label="this.showing ? this.hideLabel : this.showLabel">
            <img class="o-tuqui-systray-icon"
                 src="/tuqui_assistant/static/img/tuqui-smile.svg" alt="Tuqui"/>
        </button>
    </t>
</templates>
