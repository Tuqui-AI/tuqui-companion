<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tuqui_automation.TriggerAddDialog">
        <Dialog title.translate="When should your agent be triggered?" size="'lg'">
            <div class="row g-3">
                <t t-foreach="this.cards" t-as="card" t-key="card.trigger">
                    <div class="col-12 col-md-4">
                        <button
                            type="button"
                            class="btn btn-light border w-100 h-100 p-3 text-start o_tuqui_trigger_card"
                            t-att-data-trigger="card.trigger"
                            t-on-click="() => this.openForm(card.trigger)"
                        >
                            <i class="oi oi-2x oi-filled text-primary mb-2" t-att-data-icon="card.icon" role="img" aria-hidden="true" />
                            <div class="fw-bold" t-out="card.title" />
                            <div class="text-muted small" t-out="card.description" />
                        </button>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="this.props.close">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
