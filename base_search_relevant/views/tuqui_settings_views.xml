<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tuqui_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.search.relevant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="tuqui.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_tuqui_open_events']" position="after">
                <button name="action_tuqui_open_search_configs" type="object"
                        string="Search index" icon="search"
                        class="btn-link p-0"/>
            </xpath>
        </field>
    </record>

</odoo>
